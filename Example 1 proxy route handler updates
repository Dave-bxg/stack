import { generators } from "openid-client";

async function saveVerifierAndState() {
  const codeVerifier = generators.codeVerifier();
  const codeChallenge = generators.codeChallenge(codeVerifier);
  const state = generators.state();
  
  await yourSessionStorage.save(state, { codeVerifier });
  
  return { codeVerifier, codeChallenge, state };
}

export async function oauthRedirect({ req, body, ctx, mdb }: BXGHandlerProps<{}>) {
  const qp = parseSearchParamsToObject(req);
  
  const stored = await yourSessionStorage.get(qp.state);
  if (!stored) throw new Error("Invalid state");

  const tokenResponse = await fetch('http://localhost:8102/api/v1/auth/oauth/token', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded'
    },
    body: new URLSearchParams({
      grant_type: 'authorization_code',
      code: qp.code,
      redirect_uri: "http://localhost:3001/api/v1/oauth/callback",
      client_id: NEXT_PUBLIC_STACK_PROJECT_ID,
      client_secret: NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY,
      code_verifier: stored.codeVerifier
    })
  });

  // ... handle token response
} 
